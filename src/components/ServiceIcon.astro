---
import type { ServiceIconName } from '../lib/services';

interface Props {
  name: ServiceIconName;
}
const { name } = Astro.props;

const shared = {
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.8',
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
  class: 'h-6 w-6',
};
---

{name === 'database' && (
  <svg {...shared}>
    <ellipse cx="12" cy="5" rx="8" ry="3" />
    <path d="M4 5v6c0 1.66 3.58 3 8 3s8-1.34 8-3V5" />
    <path d="M4 11v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6" />
  </svg>
)}
{name === 'code' && (
  <svg {...shared}>
    <path d="M8 6l-5 6 5 6" />
    <path d="M16 6l5 6-5 6" />
  </svg>
)}
{name === 'server' && (
  <svg {...shared}>
    <rect x="3" y="4" width="18" height="6" rx="1.5" />
    <rect x="3" y="14" width="18" height="6" rx="1.5" />
    <circle cx="7" cy="7" r="0.8" fill="currentColor" stroke="none" />
    <circle cx="7" cy="17" r="0.8" fill="currentColor" stroke="none" />
  </svg>
)}
{name === 'percent' && (
  <svg {...shared}>
    <line x1="19" y1="5" x2="5" y2="19" />
    <circle cx="7.5" cy="7.5" r="2.5" />
    <circle cx="16.5" cy="16.5" r="2.5" />
  </svg>
)}
{name === 'ledger' && (
  <svg {...shared}>
    <rect x="4" y="3" width="16" height="18" rx="1.5" />
    <line x1="8" y1="8" x2="16" y2="8" />
    <line x1="8" y1="12" x2="16" y2="12" />
    <line x1="8" y1="16" x2="12" y2="16" />
  </svg>
)}
{name === 'workflow' && (
  <svg {...shared}>
    <rect x="3" y="4" width="6" height="5" rx="1" />
    <rect x="15" y="15" width="6" height="5" rx="1" />
    <path d="M9 6.5h4a2 2 0 0 1 2 2V15" />
  </svg>
)}
{name === 'globe' && (
  <svg {...shared}>
    <circle cx="12" cy="12" r="9" />
    <path d="M3 12h18" />
    <path d="M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z" />
  </svg>
)}
{name === 'search' && (
  <svg {...shared}>
    <circle cx="11" cy="11" r="6.5" />
    <line x1="16" y1="16" x2="21" y2="21" />
  </svg>
)}
