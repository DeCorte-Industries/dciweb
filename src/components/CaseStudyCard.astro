---
import type { CaseStudy } from '../lib/caseStudies';

interface Props {
  study: CaseStudy;
}
const { study } = Astro.props;
---

<a
  href={`/case-studies/${study.slug}/`}
  class="group flex flex-col rounded-md border border-ink/10 bg-white p-6 transition hover:border-signal hover:shadow-sm"
>
  <span class="font-mono text-xs uppercase tracking-widest text-smoke">case study</span>
  <h3 class="mt-2 font-display text-lg font-semibold text-ink group-hover:text-signal">{study.title}</h3>
  <p class="mt-1 text-xs text-smoke">{study.client}</p>
  <p class="mt-3 flex-1 text-sm text-smoke">{study.summary}</p>
  <span class="mt-4 inline-flex items-center gap-1 font-mono text-xs font-medium uppercase tracking-widest text-signal">
    Read it <span aria-hidden="true" class="transition group-hover:translate-x-0.5">&rarr;</span>
  </span>
</a>
