---
import type { SocialLink } from '../lib/sanity';
import { bookkeepingDisclaimer, fallbackContactEmail, fallbackLocation, fallbackSocialLinks } from '../lib/site';

interface Props {
  companyName?: string;
  contactEmail?: string;
  location?: string;
  socialLinks?: SocialLink[];
}
const {
  companyName = 'DeCorte Industries',
  contactEmail = fallbackContactEmail,
  location = fallbackLocation,
  socialLinks = fallbackSocialLinks,
} = Astro.props;
const year = new Date().getFullYear();

const siteLinks = [
  { label: 'Services', href: '/services' },
  { label: 'About', href: '/about' },
  { label: 'Blog', href: '/blog' },
  { label: 'Book a call', href: '/contact' },
  { label: 'Privacy', href: '/privacy' },
];
---

<footer class="mt-20 bg-ink text-paper/70">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-10 sm:grid-cols-3">
      <div>
        <div class="flex items-center gap-2">
          <img src="/logo-icon.png" alt="" class="h-5 w-auto opacity-90 [filter:brightness(0)_invert(1)]" />
          <span class="font-display text-sm font-semibold text-paper">{companyName}</span>
        </div>
        <p class="mt-3 text-sm">{location}</p>
        <a href={`mailto:${contactEmail}`} class="mt-1 inline-block text-sm hover:text-paper">{contactEmail}</a>
      </div>

      <nav aria-label="Footer">
        <p class="font-mono text-xs uppercase tracking-widest text-paper/40">Site</p>
        <ul class="mt-3 space-y-2 text-sm">
          {siteLinks.map((link) => (
            <li><a href={link.href} class="hover:text-paper">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-paper/40">Elsewhere</p>
        <ul class="mt-3 space-y-2 text-sm">
          {socialLinks.map((link) => (
            <li><a href={link.url} rel="me noopener" target="_blank" class="hover:text-paper">{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-paper/10 pt-6 font-mono text-xs text-paper/40 sm:flex-row sm:justify-between">
      <p>&copy; {year} {companyName}. All rights reserved.</p>
      <p>-- this site is built the same way we build yours</p>
    </div>
    <p class="mt-3 max-w-3xl font-mono text-xs leading-relaxed text-paper/35">{bookkeepingDisclaimer}</p>
  </div>
</footer>
