---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <div class="py-24 text-center">
    <p class="eyebrow">error</p>
    <h1 class="mt-3 font-display text-4xl font-semibold text-ink">404</h1>
    <p class="mt-4 text-smoke">The page you're looking for doesn't exist.</p>
    <a href="/" class="mt-6 inline-block font-medium text-signal underline hover:text-signal-dark">Back to home</a>
  </div>
</BaseLayout>
