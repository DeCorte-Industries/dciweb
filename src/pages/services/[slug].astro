---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import { caseStudiesBySlug } from '../../lib/caseStudies';
import { audienceLabels, loadServices, tierBgClass, tierTextClass, type ServiceItem } from '../../lib/services';
import { bookkeepingDisclaimer } from '../../lib/site';

export async function getStaticPaths() {
  const services = await loadServices();
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

interface Props {
  service: ServiceItem;
}
const { service } = Astro.props;
const audience = audienceLabels[service.audience];
const proof = caseStudiesBySlug(service.caseStudies);
---

<BaseLayout title={service.title} description={service.summary}>
  <a href={`/services/#${service.audience}`} class="font-mono text-xs font-medium uppercase tracking-widest text-smoke hover:text-ink">
    &larr; {audience.title} services
  </a>

  <div class="mt-6 flex items-start gap-4">
    <div class={`hidden h-12 w-12 shrink-0 items-center justify-center rounded border border-ink/15 sm:flex ${tierTextClass[service.color] ?? 'text-signal'}`}>
      <ServiceIcon name={service.icon} />
    </div>
    <div>
      <p class="eyebrow">{audience.eyebrow}</p>
      <h1 class="mt-2 font-display text-3xl font-semibold text-ink sm:text-4xl">{service.title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-smoke">{service.summary}</p>
    </div>
  </div>

  {service.problem && (
    <section class="mt-12 max-w-3xl" aria-labelledby="problem-heading">
      <p class="eyebrow" id="problem-heading">the problem</p>
      <p class="mt-3 text-ink">{service.problem}</p>
    </section>
  )}

  <section class="mt-10 rounded-md border border-ink/10 bg-white" aria-labelledby="offer-heading">
    <div class="flex items-center gap-3 border-b border-ink/10 px-6 py-3 sm:px-8">
      <span class={`h-2 w-2 rounded-full ${tierBgClass[service.color] ?? 'bg-signal'}`} aria-hidden="true"></span>
      <h2 id="offer-heading" class="font-mono text-xs uppercase tracking-widest text-smoke">the offer</h2>
    </div>
    <div class="p-6 sm:p-8">
      <p class="max-w-2xl text-smoke">{service.detail.intro}</p>
      {service.detail.bullets.length > 0 && (
        <ul class="mt-5 divide-y divide-ink/5">
          {service.detail.bullets.map((bullet) => (
            <li class="flex items-start gap-3 py-2.5 text-sm text-smoke">
              <span class={`mt-2 h-1.5 w-1.5 shrink-0 rounded-full ${tierBgClass[service.color] ?? 'bg-signal'}`} aria-hidden="true"></span>
              {bullet}
            </li>
          ))}
        </ul>
      )}
      {service.detail.idealFor && (
        <p class="mt-5 text-sm text-smoke">
          <span class="font-mono text-xs font-medium uppercase tracking-wide text-ink">Good fit for </span>
          {service.detail.idealFor}
        </p>
      )}
      {service.bookkeeping && <p class="mt-5 text-xs leading-relaxed text-smoke/80">{bookkeepingDisclaimer}</p>}
    </div>
  </section>

  {service.steps.length > 0 && (
    <section class="mt-12" aria-labelledby="steps-heading">
      <p class="eyebrow" id="steps-heading">how it works</p>
      <ol class="mt-4 grid gap-5 sm:grid-cols-3">
        {service.steps.map((step, index) => (
          <li class="rounded-md border border-ink/10 bg-white p-6">
            <span class={`font-mono text-xs font-medium ${tierTextClass[service.color] ?? 'text-signal'}`}>0{index + 1}</span>
            <h3 class="mt-2 font-display text-lg font-semibold text-ink">{step.title}</h3>
            <p class="mt-2 text-sm text-smoke">{step.detail}</p>
          </li>
        ))}
      </ol>
    </section>
  )}

  {proof.length > 0 && (
    <section class="mt-12" aria-labelledby="proof-heading">
      <p class="eyebrow" id="proof-heading">proof</p>
      <div class="mt-4 grid gap-5 sm:grid-cols-2">
        {proof.map((study) => <CaseStudyCard study={study} />)}
      </div>
    </section>
  )}

  {service.faqs.length > 0 && (
    <section class="mt-12 max-w-3xl" aria-labelledby="faq-heading">
      <p class="eyebrow" id="faq-heading">faq</p>
      <dl class="mt-4 divide-y divide-ink/5 rounded-md border border-ink/10 bg-white">
        {service.faqs.map((faq) => (
          <div class="px-6 py-4">
            <dt class="font-medium text-ink">{faq.question}</dt>
            <dd class="mt-1 text-sm text-smoke">{faq.answer}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  <section class="mt-16 rounded-md bg-ink px-6 py-10 text-center text-paper sm:px-12">
    <h2 class="font-display text-2xl font-semibold">Talk it through first</h2>
    <p class="mx-auto mt-3 max-w-xl text-paper/70">A free 15-minute intro call. We'll tell you plainly whether we're a fit.</p>
    <a href="/contact" class="mt-6 inline-block rounded-md bg-signal px-6 py-3 text-sm font-semibold text-white transition hover:bg-signal-dark">
      {service.ctaLabel}
    </a>
  </section>
</BaseLayout>
