---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, urlFor } from '../../lib/sanity';

let posts: Awaited<ReturnType<typeof getPosts>> = [];
try {
  posts = await getPosts();
} catch {
  // Sanity not configured yet.
}

function formatDate(iso?: string) {
  if (!iso) return null;
  return new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title="Blog" description="Notes on fractional engineering, data platforms, and building a resilient practice.">
  <p class="eyebrow">blog</p>
  <h1 class="mt-3 font-display text-3xl font-semibold text-ink sm:text-4xl">Notes from the field</h1>
  <p class="mt-4 max-w-2xl text-smoke">
    Writing on fractional engineering, data infrastructure, and running an independent technical practice.
  </p>

  {posts.length === 0 && (
    <p class="mt-10 rounded-md border border-ink/10 bg-white p-6 text-smoke">
      No posts published yet — check back soon.
    </p>
  )}

  <div class="mt-10 space-y-6">
    {posts.map((post) => {
      const date = formatDate(post.publishedAt);
      const coverUrl = post.coverImage ? urlFor(post.coverImage)?.width(160).height(160).url() : null;
      return (
        <a href={`/blog/${post.slug.current}`} class="group block rounded-md border border-ink/10 bg-white transition hover:border-signal hover:shadow-sm">
          <div class="flex items-center gap-3 border-b border-ink/10 px-6 py-3 sm:px-8">
            <span class="font-mono text-xs uppercase tracking-widest text-smoke">
              post {date ? `· ${date}` : ''}
            </span>
          </div>
          <div class="flex items-start gap-5 p-6 sm:p-8">
            {coverUrl && (
              <img src={coverUrl} alt="" class="hidden h-20 w-20 shrink-0 rounded object-cover sm:block" />
            )}
            <div>
              <h2 class="font-display text-xl font-semibold text-ink group-hover:text-signal">{post.title}</h2>
              <p class="mt-2 max-w-2xl text-smoke">{post.summary}</p>
              <div class="mt-4 flex flex-wrap items-center gap-3">
                {post.author?.name && (
                  <span class="font-mono text-xs text-smoke">{post.author.name}</span>
                )}
                {post.tags && post.tags.length > 0 && (
                  <span class="flex flex-wrap gap-2">
                    {post.tags.map((tag: string) => (
                      <span class="rounded-full bg-signal-light px-2.5 py-0.5 font-mono text-xs text-signal-dark">{tag}</span>
                    ))}
                  </span>
                )}
              </div>
            </div>
          </div>
        </a>
      );
    })}
  </div>
</BaseLayout>
