---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteConfig } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative canonical URL. Defaults to this page's URL on the production site. */
  canonical?: string;
  /** Open Graph overrides. Each falls back to the page title, description, and site logo. */
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Adds `<meta name="robots" content="noindex">` when true. */
  noindex?: boolean;
}
const {
  title,
  description = 'DeCorte Industries',
  canonical,
  ogTitle,
  ogDescription,
  ogImage = '/logo.png',
  ogType = 'website',
  noindex = false,
} = Astro.props;

// Placeholder SEO defaults so every page emits canonical and Open Graph
// tags. The real values (per-page titles, images, robots rules) come later
// from the SEO pass; pages can already override any of them via props.
const siteUrl = Astro.site ?? new URL('https://decorteindustries.com');
const fullTitle = `${title} | DeCorte Industries`;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(ogImage, siteUrl).href;

const site = await getSiteConfig();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content="DeCorte Industries" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle ?? fullTitle} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col bg-paper font-body text-ink">
    <Header companyName={site.companyName} />
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-12">
      <slot />
    </main>
    <Footer
      companyName={site.companyName}
      contactEmail={site.contactEmail}
      location={site.location}
      socialLinks={site.socialLinks}
    />
  </body>
</html>
